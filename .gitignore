# Publish only the final delivery; keep all local history untouched.
/*
!/.gitignore
!/README.md
!/FILES.md
!/AGENTS.md
!/3D/
!/Code/
!/PCB/
!/tools/

# Mechanical source and one current Blender scene.
/3D/*.blend*
!/3D/Vehicle Layout v15.blend
/3D/~$*
/tools/*
!/tools/step_to_obj.py
!/tools/README.md

# Current firmware, host software, tests and selected final documentation.
/Code/*
!/Code/README.md
!/Code/MecanumB_Control/
!/Code/ESP32_Radio_Bridge/
!/Code/ros2_ws/
!/Code/pi/
!/Code/tests/
!/Code/tools/
!/Code/cubemx/
!/Code/docs/
!/Code/reports/
/Code/cubemx/*
!/Code/cubemx/B板引脚分配_v1.csv
/Code/tools/gen_ioc.py
/Code/docs/*
!/Code/docs/FreeRTOS程序报告_v1.html
!/Code/docs/代码与电路一致性复核_v1.md
!/Code/docs/B板引脚定义_v1.md
!/Code/docs/参数持久化与健康保护_v1.md
/Code/reports/*
!/Code/reports/hardware_contract_v1.json
!/Code/reports/firmware_image_contract_v1.json
!/Code/reports/verification_final_v1.json
/Code/ros2_ws/*
!/Code/ros2_ws/src/
/Code/pi/config-halted-pending.txt
!/Code/pi/config-halted-pending.txt

# Final EDA archive, exact BOMs, harness contract and final audit evidence.
/PCB/*
!/PCB/README.md
!/PCB/backups/
!/PCB/bom/
!/PCB/design/
!/PCB/docs/
!/PCB/reports/
/PCB/backups/*
!/PCB/backups/PCB3_1_routing_complete.epro2
/PCB/bom/*
!/PCB/bom/PCB3_1_填孔盖帽孔位表_v1.csv
!/PCB/bom/BOM_PCB2_final.csv
!/PCB/bom/BOM_PCB3_1_final.csv
/PCB/design/*
!/PCB/design/AB_INTERCONNECT_v1.json
/PCB/docs/*
!/PCB/docs/PCB3_1_布线完成复核_v1.md
/PCB/reports/*
!/PCB/reports/PCB3_1_routing_complete.png
!/PCB/reports/pcb3_1_closeout_summary.json
!/PCB/reports/pcb3_1_completed_drc.json
!/PCB/reports/pcb3_1_completed_connectivity.json
!/PCB/reports/pcb3_1_completed_ground_audit.json

# Never publish generated build trees or account/runtime data.
**/__pycache__/
*.py[cod]
**/.pytest_cache/
**/.pio/
**/build/
**/install/
**/log/
.venv/
venv/
.env
.env.*
*.swp
*.swo
*.bak
~$*
